# ── Required ──
QUIZ_DATABASE_URL=postgresql+asyncpg://quiz:quiz@localhost:5432/quiznight
QUIZ_SECRET_KEY=change-me-in-production

# ── Optional — pipeline API keys ──
QUIZ_OMDB_API_KEY=
QUIZ_ANTHROPIC_API_KEY=

# ── Optional — premium/payments ──
QUIZ_PREMIUM_PRICE_ID=
QUIZ_APPLE_SHARED_SECRET=
QUIZ_GOOGLE_PLAY_KEY_PATH=

# ── Tunables ──
QUIZ_DEBUG=true
QUIZ_QUESTIONS_PER_ROUND=20
QUIZ_MIN_QUALITY_SCORE=0.5
QUIZ_ANSWER_REVEAL_RATE_LIMIT=60
QUIZ_GLOBAL_RATE_LIMIT=200
